# Copy this file to .env.local and fill in your own Supabase project's values.
# Find these under Project Settings -> API in the Supabase dashboard.
# NEXT_PUBLIC_ vars are safe to expose to the browser — see the note at the
# top of supabase/migrations/0001_init.sql for why the anon key alone can't
# be used to cheat currency, usernames, or card ownership.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
